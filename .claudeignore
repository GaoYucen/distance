# ==========================================
# 1. 机器学习与数据挖掘 (核心 Token 消耗大户)
# ==========================================
# 屏蔽所有的模型权重文件（绝不能让 LLM 读取）
*.pth
*.pt
*.h5
*.onnx
*.safetensors

# 屏蔽数据集和大型样本文件
datasets/
data/
*.csv
*.tsv
*.jsonl
*.parquet

# 屏蔽训练日志和可视化文件
logs/
runs/
tensorboard/
*.log

# ==========================================
# 2. Python 基础环境配置
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
venv/
env/
.env

# ==========================================
# 3. LaTeX 编译产物 (学术写作必备)
# ==========================================
# 屏蔽所有中间编译文件和最终生成的 PDF
*.aux
*.bbl
*.blg
*.log
*.out
*.pdf
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc
*.lof
*.lot

# ==========================================
# 4. 系统与 IDE 缓存
# ==========================================
# macOS 系统文件
.DS_Store
.AppleDouble
.LSOverride

# VS Code 配置（除非需要让模型帮忙改 settings.json）
.vscode/

# Git 历史 (避免模型读取海量的 commit 历史)
.git/